# Resend — transactional email
RESEND_API_KEY=

# Contact form recipient
CONTACT_EMAIL=

# Public site URL (used for metadata and OG tags)
NEXT_PUBLIC_SITE_URL=https://blooming-group.eu

# Sentry — error monitoring
# The DSN is not a secret — safe to expose in client code
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=z040qeme
NEXT_PUBLIC_SANITY_DATASET=production

# Upstash Redis — global rate limiting (shared across all Vercel edge instances)
# These ARE secrets — never expose in client code (no NEXT_PUBLIC_ prefix)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
